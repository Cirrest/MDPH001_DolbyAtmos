#!/sbin/sh
# Author: Cirrest
umask 022

ui_print() {
  echo "$1"
}

abort_install() {
  ui_print "! Magisk 20.4 or newer is required"
  exit 1
}

OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] || abort_install
. /data/adb/magisk/util_functions.sh
[ "${MAGISK_VER_CODE:-0}" -ge 20400 ] || abort_install
install_module
exit 0
