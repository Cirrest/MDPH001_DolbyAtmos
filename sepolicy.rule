# Author: Cirrest
# Required for the Cirrest wrapper to exec the preserved MD audio HAL in-place.
allow mtk_hal_audio mtk_hal_audio_exec file execute_no_trans
# Required for DAP Spatializer to find the DMS HIDL service registered under the target's default label.
allow mtk_hal_audio default_android_hwservice hwservice_manager find
# MD-PH-001 labels vendor.audio.spatial.* as vendor_default_prop; without this
# the DAP Spatializer cannot publish its active output device/enabled state.
allow mtk_hal_audio vendor_default_prop property_service set
